<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_classic"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Top Header: Logo, Month Title, Today Badge & Theme Toggle -->
    <RelativeLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <!-- Left: Logo & Month Title -->
        <LinearLayout
            android:id="@+id/widget_title_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/widget_actions_group"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_logo"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="5dp"
                android:contentDescription="@string/app_name"
                android:src="@mipmap/ic_launcher_round" />

            <TextView
                android:id="@+id/widget_month_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Октябрь 2026"
                android:textColor="#1E293B"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Right: Today Badge & Theme Toggle Button -->
        <LinearLayout
            android:id="@+id/widget_actions_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_today_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_badge_bg"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="20 окт"
                android:textColor="#FF477E"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_theme_toggle"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/widget_theme_btn_bg"
                android:clickable="true"
                android:contentDescription="Сменить тему виджета"
                android:focusable="true"
                android:padding="2dp"
                android:src="@drawable/ic_widget_theme_sun" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Weekday Labels Row (Пн, Вт, Ср, Чт, Пт, Сб, Вс) -->
    <LinearLayout
        android:id="@+id/widget_weekdays_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp"
        android:orientation="horizontal"
        android:weightSum="7">

        <TextView
            android:id="@+id/widget_wd_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Пн"
            android:textColor="#94A3B8"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_wd_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Вт"
            android:textColor="#94A3B8"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_wd_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Ср"
            android:textColor="#94A3B8"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_wd_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Чт"
            android:textColor="#94A3B8"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_wd_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Пт"
            android:textColor="#94A3B8"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_wd_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Сб"
            android:textColor="#F43F5E"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_wd_7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Вс"
            android:textColor="#F43F5E"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Calendar Grid Dynamic Image -->
    <ImageView
        android:id="@+id/widget_calendar_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:contentDescription="Календарная сетка"
        android:scaleType="fitCenter" />

</LinearLayout>
